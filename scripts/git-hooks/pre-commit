#!/usr/bin/env bash
set -euo pipefail

# Paths that must never appear in a commit.
# Add entries as "directory/" (trailing slash) or exact file names.
FORBIDDEN_PATHS=(
    ".vscode/"
    ".idea/"
    ".env"
    ".aienv"
)

staged=$(git diff --cached --name-only)

for pattern in "${FORBIDDEN_PATHS[@]}"; do
    matches=$(echo "$staged" | grep "^${pattern}" || true)
    if [[ -n "$matches" ]]; then
        echo ""
        echo "============================================="
        echo "  COMMIT BLOCKED"
        echo "============================================="
        echo ""
        echo "  Staged files match forbidden path: ${pattern}"
        echo ""
        echo "$matches" | while IFS= read -r f; do echo "    - $f"; done
        echo ""
        echo "  Unstage with:  git reset HEAD ${pattern}"
        echo "============================================="
        echo ""
        exit 1
    fi
done
