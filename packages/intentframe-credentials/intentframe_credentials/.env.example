# ─────────────────────────────────────────────────────────────────────────────
# IntentFrame Credential Vault — dev server seed file
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored — NEVER commit real secrets.
#
# ── Email accounts ────────────────────────────────────────────────────────────
#
# Add one ADDRESS + PASSWORD pair per account.
# <LABEL> is any tag you choose (WORK, PERSONAL, etc.) — it's only used
# to pair the two variables and does not appear anywhere in the vault.
#
# For Gmail:   use an App Password (Google Account → Security → App Passwords)
# For Outlook: use an App Password (account.microsoft.com → Security)
# For iCloud:  use an App-Specific Password (appleid.apple.com)
#
# These become vault namespaces like:  email.<address> / password
# Delivery: executor_only, allowed_consumers: ["edi"]
# ─────────────────────────────────────────────────────────────────────────────

# Account 1 — Gmail
EMAIL_WORK_ADDRESS=you@gmail.com
EMAIL_WORK_PASSWORD=abcd-efgh-ijkl-mnop

# Account 2 — Outlook / Hotmail
EMAIL_PERSONAL_ADDRESS=you@outlook.com
EMAIL_PERSONAL_PASSWORD=xxxx-yyyy-zzzz-wwww

# Account 3 — iCloud
# EMAIL_ICLOUD_ADDRESS=you@icloud.com
# EMAIL_ICLOUD_PASSWORD=your-app-specific-password

# Account 4 — Yahoo
# EMAIL_YAHOO_ADDRESS=you@yahoo.com
# EMAIL_YAHOO_PASSWORD=your-app-password

# Account 5 — Custom domain (IMAP auto-detection: imap.<domain> / smtp.<domain>)
# EMAIL_CUSTOM_ADDRESS=you@mycustomdomain.com
# EMAIL_CUSTOM_PASSWORD=your-password

# ── LLM API keys ──────────────────────────────────────────────────────────────
# These are seeded as runtime_env credentials — the supervisor injects them
# as OPENAI_API_KEY / ANTHROPIC_API_KEY into agent process environments.

OPENAI_API_KEY=sk-proj-your-key-here
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Other services (add to CREDENTIAL_MAP in dev_server.py to activate) ──────

# GITHUB_TOKEN=ghp_your-token-here
# NOTION_API_KEY=ntn_your-key-here
