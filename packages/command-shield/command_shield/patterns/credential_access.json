[
  {
    "id": "EXFIL-001",
    "regex": "curl\\s+.*(-d|--data|-F|--form)\\s+.*(\\.ssh|\\.aws|\\.config|\\.gnupg)",
    "verdict": "CATASTROPHIC",
    "description": "Exfiltrates credentials via curl",
    "source": "hardstop-patterns",
    "category": "credential_exfil"
  },
  {
    "id": "EXFIL-002",
    "regex": "wget\\s+.*--post-(data|file)\\s+.*(\\.ssh|\\.aws|\\.config)",
    "verdict": "CATASTROPHIC",
    "description": "Exfiltrates credentials via wget",
    "source": "hardstop-patterns",
    "category": "credential_exfil"
  },
  {
    "id": "EXFIL-003",
    "regex": "cat\\s+.*(\\.ssh/id_|\\.aws/credentials|\\.env)\\s*\\|",
    "verdict": "CATASTROPHIC",
    "description": "Pipes credentials to another command",
    "source": "hardstop-patterns",
    "category": "credential_exfil"
  },
  {
    "id": "EXFIL-004",
    "regex": "tar\\s+.*\\s+(\\.ssh|\\.aws|\\.gnupg|\\.config).*\\|.*(nc|curl|wget)",
    "verdict": "CATASTROPHIC",
    "description": "Archives and exfiltrates credentials",
    "source": "hardstop-patterns",
    "category": "credential_exfil"
  },
  {
    "id": "EXFIL-005",
    "regex": "scp\\s+.*(\\.ssh|\\.aws|\\.config).*@",
    "verdict": "CATASTROPHIC",
    "description": "Copies credentials to remote host",
    "source": "hardstop-patterns",
    "category": "credential_exfil"
  },
  {
    "id": "EXFIL-006",
    "regex": "cat\\s+~/\\.(ssh|aws|gnupg)/.*\\|\\s*nc\\s+",
    "verdict": "CATASTROPHIC",
    "description": "Pipes credentials via netcat",
    "source": "hardstop-patterns",
    "category": "credential_exfil"
  },

  {
    "id": "CREAD-001",
    "regex": "cat\\s+.*\\.ssh/(id_rsa|id_ed25519|id_ecdsa|id_dsa)",
    "verdict": "CATASTROPHIC",
    "description": "Reads SSH private key",
    "source": "hardstop-patterns",
    "category": "credential_read"
  },
  {
    "id": "CREAD-002",
    "regex": "cat\\s+.*\\.aws/credentials",
    "verdict": "CATASTROPHIC",
    "description": "Reads AWS credentials",
    "source": "hardstop-patterns",
    "category": "credential_read"
  },
